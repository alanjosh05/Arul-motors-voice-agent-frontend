# Arul Motors ERP on GoDaddy (Apache): caching, compression, security headers, error page.
# Copied into out/ by `npm run build`; upload it with the rest of out/.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Compress text files on the way out (the JS bundle shrinks ~70%).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Build files under /_next/static/ have a content hash in their name, so a
  # new build always gets new names: the browser can keep them for a year.
  SetEnvIf Request_URI "^/_next/static/" HASHED_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET

  # Pages: always ask the server whether there's a newer version (a quick
  # 304 when there isn't), so a new upload shows up straight away.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Logo and icons: a day.
  <FilesMatch "\.(svg|png|ico|webp)$">
    Header set Cache-Control "public, max-age=86400" env=!HASHED_ASSET
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Security headers (2026-11-09).
  # HTTPS only, for two years.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  # No other site may show the ERP inside a frame (clickjacking).
  Header always set X-Frame-Options "DENY"
  # The microphone is for agent calls; nothing else is ever needed.
  Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # Content-Security-Policy: what pages may load and where they may send data.
  # - Data only goes to this site and the backend (a script injected by an
  #   attacker couldn't send customer data or the login anywhere else).
  # - Scripts only from this site; 'unsafe-inline' because Next.js writes its
  #   page data in inline scripts; blob: for the call panel's audio worklet.
  # - No plugins from other sites, no frames, no <base> or form tricks.
  # If the backend ever moves, change connect-src here too.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://backend.arulmotors.com wss://backend.arulmotors.com; object-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>
