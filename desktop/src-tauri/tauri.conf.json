{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arul Motors ERP",
  "version": "1.0.0",
  "identifier": "com.arulmotors.erp",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src https://crm.arulmotors.com",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "publisher": "Arul Motors",
    "copyright": "© Arul Motors, Nazareth",
    "category": "Business",
    "shortDescription": "Arul Motors ERP",
    "longDescription": "Desktop app for the Arul Motors ERP (crm.arulmotors.com).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
